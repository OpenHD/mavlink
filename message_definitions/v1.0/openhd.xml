<?xml version='1.0'?>
<mavlink>
    <include>common.xml</include>
    <include>ardupilotmega.xml</include>

    <enums>
        <enum name="OPENHD_CMD">
            <description>Commands for OpenHD</description>
            <entry value="11200" name="OPENHD_CMD_INITIATE_CHANNEL_SEARCH" hasLocation="false" isDestination="false">
                <description>Initiate channel search, aka find the channel the air unit is currently running on</description>
                <param index="1" label="Instance" minValue="0" increment="1">frequency channels to scan, 0=2.4G and 5.8G, 1: 2.4G only, 2: 5G only</param>
                <param index="5">Empty</param>
                <param index="5">Empty</param>
                <param index="6">Empty</param>
                <param index="7">Empty</param>
            </entry>

            <entry value="11201" name="OPENHD_CMD_DUMMY1" hasLocation="false" isDestination="false">
                <description>dummy1</description>
                <param index="5">Empty</param>
                <param index="5">Empty</param>
                <param index="6">Empty</param>
                <param index="7">Empty</param>
            </entry>

            <entry value="11202" name="OPENHD_CMD_DUMMY2" hasLocation="false" isDestination="false">
                <description>dummy2</description>
                <param index="5">Empty</param>
                <param index="5">Empty</param>
                <param index="6">Empty</param>
                <param index="7">Empty</param>
            </entry>

        </enum>
    </enums>


    <messages>

        <message id="1211" name="OPENHD_STATS_MONITOR_MODE_WIFI_LINK">
            <wip />
            <description>Statistics for a monitor mode TX and RX link</description>
            <field type="int16_t" name="curr_tx_pps">tx packets per second</field>
            <field type="int16_t" name="curr_rx_pps">rx packets per second</field>
            <field type="int32_t" name="curr_tx_bps">tx bits per second</field>
            <field type="int32_t" name="curr_rx_bps">rx bits per second</field>
            <field type="int8_t" name="curr_rx_packet_loss_perc">curr_rx_packet_loss</field>
            <field type="int16_t" name="curr_rx_big_gaps_counter">complicated but important stat</field>
            <field type="uint32_t" name="count_tx_inj_error_hint">count_tx_inj_error_hint</field>
            <field type="uint32_t" name="count_tx_dropped_packets">count_tx_dropped_packets</field>
            <field type="uint8_t" name="curr_tx_card_idx">multi rx - idx of card currently selected for TX</field>
            <field type="uint16_t" name="curr_tx_channel_mhz">curr tx channel used when injecting packets</field>
            <field type="uint8_t" name="curr_tx_channel_w_mhz">curr tx channel width used when injecting packets (20mhz/40Mhz)</field>
            <field type="uint8_t" name="curr_tx_stbc_lpdc_shortguard_bitfield">bit field where first 3 bits refer to weather stbc,ldpc or short guard are enabled</field>
            <field type="uint8_t" name="curr_tx_mcs_index">curr tx mcs index used when injecting packets</field>
            <field type="uint16_t" name="curr_rate_kbits">curr link rate, in kbit/s, might be slightly lower than default for MCS when TX errors are detected</field>
            <field type="int8_t" name="tx_passive_mode_is_enabled">OpenHD, act as a passive listener (NO TX EVER), 0=disabled, 1=enabled</field>
            <field type="uint8_t" name="curr_n_rate_adjustments">If the TX cannot keep up (at a given mcs), openhd reduces the bitrate in 1MBit/s increments</field>
            <field type="int8_t" name="dummy0">for future use</field>
            <field type="int16_t" name="dummy1">for future use</field>
            <field type="int32_t" name="dummy2">for future use</field>
        </message>

        <message id="1212" name="OPENHD_STATS_MONITOR_MODE_WIFI_CARD">
            <wip />
            <description>Statstics for a monitor mode wifi card</description>
            <field type="uint8_t" name="card_index">A system / component might have more than one card for diversity</field>
            <field type="uint8_t" name="card_type">r.n only 0 for rtl8812au</field>
            <field type="int8_t" name="rx_rssi">rx rssi in dBm of this card - depending on the hw, might be the max of all antennas or different</field>
            <field type="int8_t" name="rx_rssi_1">rx rssi in dBm for antenna 1</field>
            <field type="int8_t" name="rx_rssi_2">rx rssi in dBm for antenna 2</field>
            <field type="int8_t" name="rx_rssi_noise">depends on the wifi driver</field>
            <field type="int8_t" name="rx_signal_quality">depends on the wifi driver</field>
            <field type="int16_t" name="tx_power">either in override index units or mW</field>
            <field type="uint32_t" name="count_p_received">All received (incoming) packets</field>
            <field type="uint32_t" name="count_p_injected">All injected (outgoing) packets</field>
            <field type="int8_t" name="curr_rx_packet_loss_perc">rx packet loss (for this card)</field>
            <field type="uint8_t" name="curr_status">set to 1 if something's wrong with the card</field>
            <field type="int8_t" name="dummy0">for future use</field>
            <field type="int16_t" name="dummy1">for future use</field>
            <field type="int32_t" name="dummy2">for future use</field>
        </message>

        <message id="1213" name="OPENHD_STATS_TELEMETRY">
            <wip />
            <description>Telemetry is always bidirectional, so rx / tx stats are available from both air and ground</description>
            <field type="int16_t" name="curr_tx_pps">tx packets per second</field>
            <field type="int16_t" name="curr_rx_pps">rx packets per second</field>
            <field type="int32_t" name="curr_tx_bps">tx bits per second</field>
            <field type="int32_t" name="curr_rx_bps">rx bits per second</field>
            <field type="int16_t" name="curr_rx_packet_loss_perc">curr_rx_packet_loss_perc</field>
            <field type="int8_t" name="dummy0">for future use</field>
            <field type="int16_t" name="dummy1">for future use</field>
            <field type="int32_t" name="dummy2">for future use</field>
        </message>

        <message id="1214" name="OPENHD_STATS_WB_VIDEO_AIR">
            <wip />
            <description>Generated on air,one per primary/secondary video</description>
            <field type="uint8_t" name="link_index">link_index</field>
            <field type="int16_t" name="curr_recommended_bitrate">curr_recommended_bitrate</field>
            <field type="int32_t" name="curr_measured_encoder_bitrate">curr_measured_encoder_bitrate</field>
            <field type="int32_t" name="curr_injected_bitrate">curr_injected_bitrate (+FEC overhead)</field>
            <field type="int32_t" name="curr_injected_pps">curr_injected_pps</field>
            <field type="int32_t" name="curr_dropped_frames">curr_dropped_frames</field>
            <field type="int16_t" name="curr_fec_percentage">curr_fec_percentage</field>
            <field type="int8_t" name="dummy0">for future use</field>
            <field type="int16_t" name="dummy1">for future use</field>
            <field type="int32_t" name="dummy2">for future use</field>
        </message>

        <message id="1215" name="OPENHD_STATS_WB_VIDEO_AIR_FEC_PERFORMANCE">
            <wip />
            <description>FEC encode performance stats, only for developers</description>
            <field type="uint8_t" name="link_index">link_index</field>
            <field type="uint32_t" name="curr_fec_encode_time_avg_us">curr_fec_encode_time_avg_us</field>
            <field type="uint32_t" name="curr_fec_encode_time_min_us">curr_fec_encode_time_min_us</field>
            <field type="uint32_t" name="curr_fec_encode_time_max_us">curr_fec_encode_time_max_us</field>
            <field type="uint16_t" name="curr_fec_block_size_avg">curr_fec_block_size_avg</field>
            <field type="uint16_t" name="curr_fec_block_size_min">curr_fec_block_size_min</field>
            <field type="uint16_t" name="curr_fec_block_size_max">curr_fec_block_size_max</field>
            <field type="int8_t" name="dummy0">for future use</field>
            <field type="int16_t" name="dummy1">for future use</field>
            <field type="int32_t" name="dummy2">for future use</field>
        </message>

        <message id="1216" name="OPENHD_STATS_WB_VIDEO_GROUND">
            <wip />
            <description>Generated on ground,one per primary/secondary video</description>
            <field type="uint8_t" name="link_index">link_index</field>
            <field type="int32_t" name="curr_incoming_bitrate">todo</field>
            <field type="uint32_t" name="count_blocks_total">count_blocks_total</field>
            <field type="uint32_t" name="count_blocks_lost">count_blocks_lost</field>
            <field type="uint32_t" name="count_blocks_recovered">count_blocks_recovered</field>
            <field type="uint32_t" name="count_fragments_recovered">count_fragments_recovered</field>
            <field type="int8_t" name="dummy0">for future use</field>
            <field type="int16_t" name="dummy1">for future use</field>
            <field type="int32_t" name="dummy2">for future use</field>
        </message>

        <message id="1217" name="OPENHD_STATS_WB_VIDEO_GROUND_FEC_PERFORMANCE">
            <wip />
            <description>FEC encode performance stats, only for developers</description>
            <field type="uint8_t" name="link_index">link_index</field>
            <field type="uint32_t" name="curr_fec_decode_time_avg_us">todo</field>
            <field type="uint32_t" name="curr_fec_decode_time_min_us">todo</field>
            <field type="uint32_t" name="curr_fec_decode_time_max_us">todo</field>
            <field type="int8_t" name="dummy0">for future use</field>
            <field type="int16_t" name="dummy1">for future use</field>
            <field type="int32_t" name="dummy2">for future use</field>
        </message>

        <message id="1218" name="OPENHD_ONBOARD_COMPUTER_STATUS_EXTENSION">
            <wip />
            <description>This is for values that cannot be already done with the mavlink onboard computer status message</description>
            <field type="uint16_t" name="cpu_core_voltage_milliV">cpu_core_voltage_milliV</field>
            <field type="uint8_t" name="over_current">bool over_current</field>
            <field type="uint16_t" name="reserved1">reserved1</field>
            <field type="uint16_t" name="reserved2">reserved1</field>
            <field type="uint16_t" name="reserved3">reserved1</field>
            <field type="uint16_t" name="reserved4">reserved1</field>
        </message>

        <message id="1219" name="OPENHD_CAMERA_STATUS">
            <wip />
            <description>Info / stats about a openhd camera (stream) that are regularly sent (broadcast)</description>
            <field type="uint8_t" name="cam_type">0==Unknown, follows the definitions in openhd (camera_enums.hpp)</field>
            <field type="uint8_t" name="cam_status">0==Unknown, 1==camera is currently streaming, 2==camera is currently restarting</field>
            <field type="uint8_t" name="supports_variable_bitrate">Set to 1 if camera supports variable bitrate (changing the bitrate)</field>
            <field type="uint8_t" name="air_recording_active">air_recording_active</field>
            <field type="uint8_t" name="encoding_format">0 for h264, 1 for h265, 2 for mjpeg</field>
            <field type="uint16_t" name="encoding_bitrate_kbits">encoding_bitrate_kbits</field>
            <field type="uint8_t" name="encoding_keyframe_interval">encoding_keyframe_interval</field>
            <field type="uint16_t" name="stream_w">streamed video width</field>
            <field type="uint16_t" name="stream_h">streamed video height</field>
            <field type="uint16_t" name="stream_fps">streamed video fps</field>
            <field type="int8_t" name="dummy0">for future use</field>
            <field type="int16_t" name="dummy1">for future use</field>
            <field type="int32_t" name="dummy2">for future use</field>
        </message>

        <message id="1220" name="OPENHD_LOG_MESSAGE">
            <description>Log message for internal Open.HD components</description>
            <field type="uint8_t" name="severity" enum="MAV_SEVERITY">severity level, relies on the definitions within RFC-5424.</field>
            <field type="char[10]" name="tag">log tag,must not be null-terminated</field>
            <field type="char[50]" name="message">log message,must not be null-terminated</field>
            <field type="uint64_t" name="timestamp">timestamp when message was originally generated</field>
        </message>

        <message id="1221" name="OPENHD_VERSION_MESSAGE">
            <description>The current Open.HD version running on the system sending the message</description>
            <field type="char[30]" name="version">version string, 29 character max length since it *must* be null-terminated</field>
            <field type="char[30]" name="commit_hash">commit_hash, 29 character max length since it *must* be null-terminated</field>
        </message>

        <message id="1222" name="OPENHD_WIFBROADCAST_SUPPORTED_CHANNELS">
            <description>Supported wifibroadcast channels (by a wifibroadcast card). Legal or not is not checked</description>
            <field type="uint8_t" name="card_index">index of the wifibroadcast card (RX might have multiple)</field>
            <field type="uint16_t[60]" name="channels">List of supported channels, 0 to indicate an empty field.Always in 20Mhz increments</field>
            <field type="uint8_t[80]" name="bandwidths">TODO</field>
        </message>


    </messages>

</mavlink>